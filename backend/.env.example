APP_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
PORT=3000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/sgsst
FIREBASE_PROJECT_ID=tu-proyecto-firebase
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@tu-proyecto.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=

# --- FASE 1 — Abstracción de storage (StorageService → StorageProvider) ----
# Proveedor activo de almacenamiento. Valores:
#   (vacío)      → legacy-firebase (comportamiento histórico: Firebase Storage
#                  con objetos públicos). La app ARRANCA sin configurar nada.
#   r2           → Cloudflare R2 (PRIVADO, lectura solo con signed URLs).
#   gcs          → reservado para una fase futura (todavía NO implementado).
STORAGE_PROVIDER=

# Credenciales R2 (SOLO requeridas si STORAGE_PROVIDER=r2). NUNCA escribir
# valores reales aquí: se crean en el dashboard de Cloudflare R2 (API token
# con permisos Object Read & Write sobre el bucket).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# OPCIONAL: solo si el endpoint no puede derivarse del accountId
# (por defecto: https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com).
R2_ENDPOINT=
# OPCIONAL: TTL de las signed URLs en segundos (default seguro: 300 = 5 min).
# NO es obligatorio para arrancar; la lectura de documentos es temporal,
# nunca un enlace permanente.
STORAGE_SIGNED_URL_TTL_SECONDS=

# Credenciales Backblaze B2 (SOLO requeridas si STORAGE_PROVIDER=b2). NUNCA
# escribir valores reales aquí: B2 usa su API S3-compatible mediante el SDK
# AWS ya existente; NO hace falta un SDK específico de Backblaze. Usar una
# Application Key limitada al bucket y dejar el bucket PRIVADO: los objetos
# nunca se hacen públicos, la lectura es solo con signed URLs TEMPORALES que
# caducan (nunca persistidas). El endpoint S3 real de la cuenta (de la forma
# https://s3.<region>.backblazeb2.com) es OBLIGATORIO: no se deriva del keyId.
B2_ENDPOINT=
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=

# Fase 3A — Entrega de correo transaccional (Resend). Requeridos para enviar
# correos; sin ellos la app arranca pero el envío falla de forma controlada.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=SG-SST
# URL pública del frontend usada para construir el enlace /sign/:token del
# correo (en dev apunta al Vite local; en producción al dominio real).
# Reutiliza FRONTEND_URL existente (main.ts CORS la usa igualmente).
# Ejemplo producción: https://app.tudominio.com

# Opcional: correo de soporte mostrado en la plantilla del email.
SUPPORT_EMAIL=

# Fase 3B-1 — Entrega por WhatsApp (Meta Cloud API). OPCIONAL: sin estas
# variables el backend inicia normalmente y el envío devuelve un fallo
# controlado (WHATSAPP_NOT_CONFIGURED). NO inventar valores: el Phone Number
# ID, el token y la plantilla salen de tu cuenta de Meta Business.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Plantilla business-initiated APROBADA por Meta (nombre e idioma reales de
# tu cuenta). Parámetros mínimos: {{1}} nombre del trabajador, {{2}} enlace.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=es
# Modo del proveedor: dejar VACÍO en producción. 'mock' SOLO para
# desarrollo/tests (simula envíos, nunca contacta a Meta).
WHATSAPP_PROVIDER=

# --- Fase 3B-2A: Webhook de WhatsApp (Meta) --------------------------------
# Token de VERIFICACIÓN de la suscripción del webhook en la app de Meta
# (valor que tú defines y pegas en Meta; NO reutilizar WHATSAPP_ACCESS_TOKEN).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# App Secret de la app de Meta: valida X-Hub-Signature-256 del POST
# (HMAC-SHA256 del body crudo). NUNCA reutilizar el access token como secreto.
WHATSAPP_WEBHOOK_APP_SECRET=
# Código de país para números nacionales (Colombia por defecto). Vacío = no
# inferir (útil si tu carga ya es 100% internacional).
WHATSAPP_DEFAULT_COUNTRY_CODE=57